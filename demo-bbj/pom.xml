<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>webforj-ai-chat-bbj</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>webforJ AI Chat for BBj Services</name>
  <description>Spring-free chat application hosted inside BBj Services</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <webforj.version>26.02</webforj.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.webforj</groupId>
        <artifactId>webforj-bom</artifactId>
        <version>${webforj.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>webforj-ai-chat-component</artifactId>
      <version>1.0-SNAPSHOT</version>
      <exclusions>
        <exclusion>
          <groupId>com.webforj</groupId>
          <artifactId>webforj-engine</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Keep the framework dependencies explicit in the deployment POM after shading the chat. -->
    <dependency>
      <groupId>com.webforj</groupId>
      <artifactId>webforj-foundation</artifactId>
      <exclusions>
        <exclusion>
          <groupId>com.webforj</groupId>
          <artifactId>webforj-engine</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.webforj</groupId>
      <artifactId>webforj-bundle-foundation</artifactId>
      <exclusions>
        <exclusion>
          <groupId>com.webforj</groupId>
          <artifactId>webforj-engine</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.webforj</groupId>
      <artifactId>webforj-html-elements</artifactId>
      <exclusions>
        <exclusion>
          <groupId>com.webforj</groupId>
          <artifactId>webforj-engine</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.webforj</groupId>
      <artifactId>webforj-icons</artifactId>
      <exclusions>
        <exclusion>
          <groupId>com.webforj</groupId>
          <artifactId>webforj-engine</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.webforj</groupId>
      <artifactId>webforj-markdown-viewer</artifactId>
      <exclusions>
        <exclusion>
          <groupId>com.webforj</groupId>
          <artifactId>webforj-engine</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>bbj-runtime-boundary</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>org.springframework*:*</exclude>
                    <exclude>com.webforj:webforj-spring*</exclude>
                    <exclude>com.webforj:webforj-engine</exclude>
                  </excludes>
                  <message>BBj Services supplies the engine; this host must not depend on Spring.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
      </plugin>
      <plugin>
        <groupId>com.webforj</groupId>
        <artifactId>webforj-maven-plugin</artifactId>
        <version>${webforj.version}</version>
        <extensions>true</extensions>
        <configuration>
          <!-- BBj Services loads these assets inline from the application classpath. -->
          <eager>true</eager>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <!-- The remote BBj server cannot resolve an unpublished local component snapshot. -->
              <artifactSet>
                <includes>
                  <include>com.example:webforj-ai-chat-component</include>
                </includes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>com.example:webforj-ai-chat-component</artifact>
                  <includes>
                    <include>com/example/aichat/component/**</include>
                  </includes>
                </filter>
              </filters>
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <useDependencyReducedPomInJar>true</useDependencyReducedPomInJar>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.webforj</groupId>
        <artifactId>webforj-install-maven-plugin</artifactId>
        <version>${webforj.version}</version>
        <configuration>
          <deployurl>${bbj.deployUrl}</deployurl>
          <classname>com.example.aichat.bbj.BBjChatApplication</classname>
          <publishname>ai-chat</publishname>
          <debug>false</debug>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>bbj-deploy</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>require-bbj-deployment-target</id>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireProperty>
                      <property>bbj.deployUrl</property>
                      <regex>https?://.+</regex>
                      <message>Set -Dbbj.deployUrl to the intended BBj server's webforj-install URL.</message>
                    </requireProperty>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>com.webforj</groupId>
            <artifactId>webforj-install-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>publish-to-bbj</id>
                <phase>install</phase>
                <goals>
                  <goal>install</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
